{
    "compilerOptions": {
        "strict": true,
        "noImplicitAny": false,
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "lib": ["es2022", "dom"],
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "tsdown.config.ts"],
    "exclude": ["build", "node_modules"]
}
